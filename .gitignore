# ---- Build directories (root only: not inside thirdparty/) ----
/build/
/Build/
/build-*/
/out/
/cmake-build-*/
/Makefile

# ---- Build artifacts ----

# Prerequisites
*.d

# Compiled object files
*.slo
*.lo
*.o
*.obj

# Precompiled headers
*.gch
*.pch

# Linker files
*.ilk

# Compiled dynamic libraries
*.so
*.so.*
*.dylib
*.dll

# Compiled static libraries
*.a
*.la
*.lai
*.lib

# Executables
*.exe
*.out
*.app

# Debug information
*.pdb
*.dwo
*.dSYM/

# ---- CMake generated ----
CMakeFiles/
CMakeCache.txt
CMakeScripts/
cmake_install.cmake
install_manifest.txt
compile_commands.json
CTestTestfile.cmake
CMakeUserPresets.json
_deps/

# ---- Tests & cache ----
Testing/
.cache/
.ccache/

# ---- Package managers ----
vcpkg_installed/
/conan/
conanbuildinfo.*
conaninfo.txt

# ---- IDE / editors ----
.idea/
.vs/
.vscode/
*.user
*.suo
cscope.*
tags
.clangd/
.ccls-cache/

# ---- macOS ----
.DS_Store
.AppleDouble
.LSOverride
._*

# ---- Misc ----
*.tmp
*.log
*.bak
*.swp
*~

# ---- Vendored third-party sources: keep tracked ----
!thirdparty/**/*.a
!thirdparty/**/*.lib
!thirdparty/**/*.so
!thirdparty/**/*.dylib
!thirdparty/**/Makefile
!thirdparty/**/*.out
